# LLM Provider: openrouter (recommended), cloudflare, or anthropic
LLM_PROVIDER=openrouter

# OpenRouter (recommended — no daily limit, ~$0.003/analysis)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Cloudflare Workers AI (free tier, 10k neurons/day limit)
# Only needed if LLM_PROVIDER=cloudflare
CF_ACCOUNT_ID=your_account_id_here
CF_GATEWAY_ID=default
CF_API_TOKEN=your_workers_ai_api_token_here
CF_GATEWAY_TOKEN=your_ai_gateway_auth_token_here
CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Anthropic direct API — only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3003,https://your-pages-domain.pages.dev
