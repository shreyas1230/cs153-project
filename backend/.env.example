# LLM Provider: "cloudflare" (default, free) or "anthropic"
LLM_PROVIDER=cloudflare

# Cloudflare Workers AI (via AI Gateway) — get from dash.cloudflare.com
CF_ACCOUNT_ID=your_account_id_here
CF_GATEWAY_ID=your_gateway_id_here
CF_API_TOKEN=your_cloudflare_api_token_here
CF_MODEL=@cf/meta/llama-3.3-70b-instruct

# Anthropic (only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://your-pages-domain.pages.dev
